<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 o superior. La sesión no se respalda ni se transfiere a otro teléfono (ver backup_rules.xml). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="planilla_sesion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="planilla_sesion.xml" />
    </device-transfer>
</data-extraction-rules>
