<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido de BotonEmergencia: la barra que se llena al mantener presionado y los textos -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@+id/rellenoEmergencia"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorErrorContainer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_alerta"
            app:tint="?attr/colorError" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloEmergencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergencia"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorError" />

            <TextView
                android:id="@+id/tvDetalleEmergencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mantén presionado para pedir ayuda"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>
</merge>
