<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:fillViewport="true"
    tools:context=".CambiarPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView android:id="@+id/btnVolverPassword" style="@style/Volver" />

        <TextView style="@style/TituloPantalla" android:text="Cambiar contraseña" />

        <TextView
            android:id="@+id/tvAvisoPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Al cambiarla se cierra la sesión en todos tus dispositivos y vuelves a entrar con la nueva."
            android:textColor="@color/slate_500"
            android:textSize="14sp" />

        <TextView style="@style/EtiquetaCampo" android:text="Contraseña actual" />

        <EditText
            android:id="@+id/etPasswordActual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:autofillHints="password"
            android:hint="Contraseña actual"
            android:inputType="textPassword" />

        <TextView style="@style/EtiquetaCampo" android:text="Contraseña nueva" />

        <EditText
            android:id="@+id/etPasswordNueva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="newPassword"
            android:hint="Al menos 12 caracteres"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Mínimo 12 caracteres, distinta de la actual, sin tu correo y que no sea una contraseña común. Una frase corta es fácil de recordar."
            android:textColor="@color/slate_500"
            android:textSize="12sp" />

        <TextView style="@style/EtiquetaCampo" android:text="Confirma la contraseña nueva" />

        <EditText
            android:id="@+id/etPasswordConfirmar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:autofillHints="newPassword"
            android:hint="Repite la contraseña nueva"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/tvErrorPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/red_alert"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCambiarPassword"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/green_active"
            android:text="Cambiar contraseña"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
