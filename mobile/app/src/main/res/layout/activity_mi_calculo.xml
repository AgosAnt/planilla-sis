<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Pantalla"
    android:fillViewport="true"
    tools:context=".MiCalculoActivity">

    <LinearLayout
        android:id="@+id/contenidoCalculo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button android:id="@+id/btnVolverCalculo" style="@style/Volver" />

        <TextView style="@style/TituloPantalla" android:text="Mi cálculo" />

        <TextView android:id="@+id/tvPeriodo" style="@style/Subtitulo" />

        <!-- Quincena: botones segmentados de M3, uno siempre elegido -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoQuincena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/btnQuincenaActual"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Esta quincena"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnQuincenaAnterior"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="La anterior"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCalculo"
            style="@style/Tarjeta"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView style="@style/EtiquetaDato" android:text="Horas ordinarias" />
                <TextView android:id="@+id/tvOrdinarias" style="@style/ValorDato" />

                <TextView style="@style/EtiquetaDato" android:text="Horas extra diurnas" />
                <TextView android:id="@+id/tvExtraDiurnas" style="@style/ValorDato" />

                <TextView style="@style/EtiquetaDato" android:text="Horas extra nocturnas" />
                <TextView android:id="@+id/tvExtraNocturnas" style="@style/ValorDato" />

                <TextView style="@style/EtiquetaDato" android:text="Jornadas contadas" />
                <TextView android:id="@+id/tvJornadas" style="@style/ValorDato" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Jornadas sin aprobar: aviso en el contenedor terciario (ocre) -->
        <TextView
            android:id="@+id/tvPendientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/fondo_etiqueta"
            android:backgroundTint="?attr/colorTertiaryContainer"
            android:padding="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvErrorCalculo"
            style="@style/TextoError"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            style="@style/Nota"
            android:layout_marginTop="16dp"
            android:text="Solo se cuentan las jornadas que tu supervisor ya aprobó. Los montos (pago, bonificación e IGSS) aparecen en la planilla." />
    </LinearLayout>
</ScrollView>
